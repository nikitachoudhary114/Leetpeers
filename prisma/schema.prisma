// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  username  String?  @unique
  password  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leetcodeProfile  String?  @unique
  leetcodeVerified Boolean  @default(false)
  bio              String?
  avatarUrl        String?
  githubProfile    String?
  githubVerified   Boolean  @default(false)
  linkedinProfile  String?
  country          String?
  timezone         String   @default("UTC") // User's timezone (e.g., "Asia/Kolkata", "America/New_York")

  streakCount     Int  @default(0)
  problemsSolved  Int  @default(0)
  lastTotalSolved Int?

  // Notification preferences (JSON object)
  notificationPrefs Json @default("{\"inApp\": true, \"targetReminders\": true, \"streakAlerts\": true, \"roomUpdates\": true}")

  rooms               Room[]               @relation("RoomPlayers")
  ownedRooms          Room[]               @relation("RoomOwner")
  Account             Account[]
  Session             Session[]
  StreakLog           StreakLog[]
  ProfileVerification ProfileVerification[]
  AIConversations     AIConversation[]
  RoomMessages        RoomMessage[]
  CodeSubmissions     CodeSubmission[]
  UserRoomStreak      UserRoomStreak[]
  DailyProgress       DailyProgress[]
  NotificationLog     NotificationLog[]
  Notifications       Notification[]
}

model ProfileVerification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // "leetcode" or "github"
  code      String   @unique
  username  String   // The username being verified
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

model Room {
  id        String   @id @default(cuid())
  name      String?
  code      String   @unique
  createdAt DateTime @default(now())

  dailyTarget Int @default(2)
  streakCount Int @default(0)

  ownerId String
  owner   User   @relation("RoomOwner", fields: [ownerId], references: [id])

  players         User[]           @relation("RoomPlayers")
  StreakLog       StreakLog[]
  RoomMessages    RoomMessage[]
  CodeSubmissions CodeSubmission[]
  UserRoomStreak  UserRoomStreak[]
  NotificationLog NotificationLog[]
  Notifications   Notification[]
}

// NextAuth tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model StreakLog {
  id             String   @id @default(cuid())
  userId         String
  roomId         String
  date           DateTime @db.Date // Date only, no time
  problemsSolved Int      @default(0) // Problems solved that day
  metTarget      Boolean  @default(false) // Did user meet room target?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  room Room @relation(fields: [roomId], references: [id])

  @@unique([userId, roomId, date])
  @@index([userId, date])
  @@index([roomId, date])
}

// Per-room streak tracking for individual users
model UserRoomStreak {
  id             String    @id @default(cuid())
  userId         String
  roomId         String
  streakCount    Int       @default(0) // Current streak for this user in this room
  lastActiveDate DateTime? @db.Date // Last date they met target
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId])
  @@index([userId])
  @@index([roomId])
}

// Daily LeetCode stats snapshot for delta calculation
model DailyProgress {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime @db.Date
  totalSolved Int // Total problems solved as of this date
  easyCount   Int      @default(0)
  mediumCount Int      @default(0)
  hardCount   Int      @default(0)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

// Notification log to prevent duplicate emails
model NotificationLog {
  id     String   @id @default(cuid())
  userId String
  roomId String?
  type   String // "reminder_20h" | "daily_summary" | "streak_lost"
  date   DateTime @db.Date
  sentAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  room Room? @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@unique([userId, roomId, type, date])
}

// AI Chatbot - Conversations
model AIConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]

  @@index([userId])
}

// AI Chatbot - Messages
model AIMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String   // 'user' | 'assistant'
  content        String   @db.Text
  createdAt      DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// Real-time Room Chat Messages
model RoomMessage {
  id        String   @id @default(cuid())
  roomId    String
  senderId  String
  content   String   @db.Text
  createdAt DateTime @default(now())

  room   Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([senderId])
}

// Code Submissions
model CodeSubmission {
  id          String   @id @default(cuid())
  userId      String
  roomId      String?
  problemId   Int
  problemSlug String
  language    String   // 'python' | 'javascript' | 'java' | 'cpp'
  code        String   @db.Text
  status      String   // 'pending' | 'running' | 'accepted' | 'wrong_answer' | 'error' | 'timeout'
  runtime     Int?     // ms
  memory      Int?     // KB
  testsPassed Int?
  totalTests  Int?
  output      String?  @db.Text
  error       String?  @db.Text
  createdAt   DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  room Room? @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([roomId])
  @@index([problemSlug])
}

// Test Cases for Problems
model TestCase {
  id          String  @id @default(cuid())
  problemSlug String
  input       String  @db.Text
  expected    String  @db.Text
  isHidden    Boolean @default(false)

  @@index([problemSlug])
}

// In-app Notifications
model Notification {
  id        String   @id @default(cuid())
  userId    String
  roomId    String?
  roomName  String?  // Denormalized for quick display
  type      String   // See notification types in notification-service.ts
  title     String
  message   String
  link      String?  // Optional: URL to navigate on click
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  room Room? @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}
